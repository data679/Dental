# Copy to .env and fill in real values locally or via your hosting provider's secret
# manager. Never commit the real .env file (it's gitignored) or paste real values into
# code, commit messages, or project notes/logs.

PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://dental:dental@localhost:5432/dental

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://dental-api

# Denticon / PlanetDDS REST API (read-only use) — https://developer.planetdds.com
# Auth is an Azure API Management subscription key sent as `PDDS-Subscription-Key`; it's
# issued per practice group by PlanetDDS. Leave blank and every Denticon job no-ops.
# While waiting for a key, point at the local mock instead (`npm run denticon:mock`):
#   DENTICON_API_BASE_URL=http://localhost:4900/denticon
#   DENTICON_SUBSCRIPTION_KEY=mock-key
DENTICON_API_BASE_URL=https://api.planetdds.com/denticon
DENTICON_SUBSCRIPTION_KEY=
# Legacy v1 API credentials (API-AUTH-KEY / API-VENDOR-KEY / PGID headers, as in the
# public PlanetDDS_Api_SampleCode repo). Only needed if PlanetDDS issued you those instead.
DENTICON_LEGACY_AUTH_KEY=
DENTICON_LEGACY_VENDOR_KEY=
DENTICON_PGID=
# Optional sync tuning: restrict to some office ids ("101,102"), initial backfill depth,
# and the cron schedule for the recurring incremental sync ("" disables it).
DENTICON_OFFICE_IDS=
DENTICON_BACKFILL_DAYS=365
DENTICON_SYNC_CRON=15 * * * *

# Denticon "Data Download" (BCP) feed — the scheduled full-database export from
# Utilities → Denticon Download (docs/denticon-bcp.md). The zip password is the
# requesting Denticon user's password; keep it here, never in code or notes.
DENTICON_BCP_PASSWORD=
# Folder the worker polls for new download zips (empty = manual `npm run bcp:load` only).
DENTICON_BCP_INBOX=
# Optional column-name / mapping overrides (defaults to backend/bcp-feed.json if present).
DENTICON_BCP_CONFIG=
DENTICON_BCP_CRON=*/30 * * * *
DENTICON_BCP_STALE_DAYS=2
